<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_card"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Top row: Word and action icons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvWord"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/dialog_text_primary"
                android:textSize="23sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSpeak"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="44dp"
                android:background="@drawable/bg_btn_secondary"
                android:paddingHorizontal="12dp"
                android:text="🔊 发音"
                android:textColor="@color/dialog_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnClose"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:minWidth="36dp"
                android:background="@drawable/bg_btn_secondary"
                android:text="✕"
                android:textColor="@color/dialog_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Phonetic & study tag -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPhonetic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/dialog_accent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStudyStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_dialog_tag"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:textColor="@color/dialog_tag_text"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Translation body -->
        <TextView
            android:id="@+id/tvTranslation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="5dp"
            android:maxLines="8"
            android:textColor="@color/dialog_text_primary"
            android:textSize="15sp" />

        <!-- Bottom Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnRemoveStudy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:text="不背此词"
                android:textColor="@color/dialog_text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnOpenApp"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_btn_primary"
                android:paddingHorizontal="18dp"
                android:text="在词典中打开 ↗"
                android:textColor="@color/dialog_btn_primary_text"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
